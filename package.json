{
  "name": "remote-desktop-mcp",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Persistent Desktop Commander stdio integration for OpenAI tunnel-client",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "mcp": "node scripts/proxy.mjs",
    "doctor": "node scripts/cli.mjs doctor",
    "tunnel-config": "node scripts/cli.mjs tunnel-config",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/patch-upstream.mjs && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "setup": "node scripts/setup.mjs",
    "status": "node scripts/runtime.mjs status",
    "start": "node scripts/runtime.mjs start",
    "stop": "node scripts/runtime.mjs stop",
    "postinstall": "node scripts/patch-upstream.mjs",
    "audit:high": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@wonderwhy-er/desktop-commander": "0.3.1",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "zod": "$zod"
  }
}
